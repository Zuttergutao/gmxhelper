{
	"name": "gmxlang",
	"displayName": "gmxhelper",
	"publisher": "Casea1998",
	"description": "For gromacs language support ",
	"version": "2.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/Zuttergutao/gmxhelper"
	},
	"engines": {
		"vscode": "^1.25.0"
	},
	"icon": "images/logo.png",
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:mdp",
		"onLanguage:pdb",
		"onLanguage:top",
		"onLanguage:gro",
		"onLanguage:itp",
		"onLanguage:mol2",
		"onLanguage:ndx",
		"onLanguage:xvg",
		"onLanguage:fasta",
		"onLanguage:xyz",
		"onLanguage:cif",
		"onLanguage:sdf",
		"onLanguage:mol",
		"onLanguage:amber-in",
		"onLanguage:amber-out",
		"onLanguage:amber-prmtop",
		"onLanguage:amber-rst7",
		"onLanguage:gjf",
		"onLanguage:orca-inp",
		"onLanguage:cp2k-inp",
		"onLanguage:inp"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "gmxlang.viewXvgFile",
				"title": "View XVG File",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewGroFile",
				"title": "View 3D GRO Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewPdbFile",
				"title": "View 3D PDB Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.collapseOutline",
				"title": "Collapse Outline",
				"category": "GMX"
			},
			{
				"command": "gmxlang.expandOutline",
				"title": "Expand Outline",
				"category": "GMX"
			},
			{
				"command": "gmxlang.foldAllSections",
				"title": "Fold All Sections",
				"category": "GMX"
			},
			{
				"command": "gmxlang.unfoldAllSections",
				"title": "Unfold All Sections",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewMol2File",
				"title": "View 3D MOL2 Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewXyzFile",
				"title": "View 3D XYZ Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewCifFile",
				"title": "View 3D CIF Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewSdfFile",
				"title": "View 3D SDF Structure",
				"category": "GMX"
			},
			{
				"command": "gmxlang.viewMolFile",
				"title": "View 3D MOL Structure",
				"category": "GMX"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "gmxlang.viewXvgFile",
					"when": "resourceExtname == .xvg",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewGroFile",
					"when": "resourceExtname == .gro",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewPdbFile",
					"when": "resourceExtname == .pdb",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewMol2File",
					"when": "resourceExtname == .mol2",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewXyzFile",
					"when": "resourceExtname == .xyz",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewCifFile",
					"when": "resourceExtname == .cif",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewSdfFile",
					"when": "resourceExtname == .sdf",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewMolFile",
					"when": "resourceExtname == .mol",
					"group": "navigation"
				}

			],
			"editor/title/context": [
				{
					"command": "gmxlang.viewXvgFile",
					"when": "resourceExtname == .xvg",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewGroFile",
					"when": "resourceExtname == .gro",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewPdbFile",
					"when": "resourceExtname == .pdb",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewMol2File",
					"when": "resourceExtname == .mol2",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewXyzFile",
					"when": "resourceExtname == .xyz",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewCifFile",
					"when": "resourceExtname == .cif",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewSdfFile",
					"when": "resourceExtname == .sdf",
					"group": "navigation"
				},
				{
					"command": "gmxlang.viewMolFile",
					"when": "resourceExtname == .mol",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "gmxlang.foldAllSections",
					"when": "editorLangId == pdb || editorLangId == gro || editorLangId == itp || editorLangId == top || editorLangId == ndx || editorLangId == amber-prmtop",
					"group": "gmx_folding"
				},
				{
					"command": "gmxlang.unfoldAllSections",
					"when": "editorLangId == pdb || editorLangId == gro || editorLangId == itp || editorLangId == top || editorLangId == ndx || editorLangId == amber-prmtop",
					"group": "gmx_folding"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "GmxLang",
			"properties": {
				"gmxlang.outline.autoFold": {
					"type": "boolean",
					"default": false,
					"description": "Automatically fold outline sections when opening TOP/ITP/GRO files"
				},
				"gmxlang.outline.autoCollapseOutlineView": {
					"type": "boolean",
					"default": true,
					"description": "Automatically collapse the sidebar outline view when opening TOP/ITP/GRO files"
				},
				"gmxlang.outline.foldProteinResidues": {
					"type": "boolean",
					"default": true,
					"description": "Automatically fold protein residues in GRO files"
				},
				"gmxlang.outline.foldNonImportantSections": {
					"type": "boolean",
					"default": true,
					"description": "Automatically fold non-important sections in TOP/ITP files (bonds, angles, dihedrals, etc.)"
				}
			}
		},
		"languages": [
			{
				"id": "mdp",
				"aliases": [
					"mdp"
				],
				"extensions": [
					".mdp"
				],
