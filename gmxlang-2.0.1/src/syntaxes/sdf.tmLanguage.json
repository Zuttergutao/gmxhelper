{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SDF",
	"patterns": [
		{
			"include": "#header"
		},
		{
			"include": "#counts_line"
		},
		{
			"include": "#atom_block"
		},
		{
			"include": "#bond_block"
		},
		{
			"include": "#properties"
		},
		{
			"include": "#data_items"
		},
		{
			"include": "#record_separator"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"header": {
			"patterns": [
				{
					"name": "comment.line.header.sdf",
					"match": "^.{0,80}$",
					"captures": {
						"0": {
							"name": "string.unquoted.header.sdf"
						}
					}
				}
			]
		},
		"counts_line": {
			"patterns": [
				{
					"name": "meta.counts.sdf",
					"match": "^\\s*(\\d{1,3})\\s*(\\d{1,3}).*V2000\\s*$",
					"captures": {
						"1": {
							"name": "constant.numeric.atom-count.sdf"
						},
						"2": {
							"name": "constant.numeric.bond-count.sdf"
						}
					}
				}
			]
		},
		"atom_block": {
			"patterns": [
				{
					"name": "meta.atom.sdf",
					"match": "^\\s*([-+]?\\d*\\.?\\d+)\\s+([-+]?\\d*\\.?\\d+)\\s+([-+]?\\d*\\.?\\d+)\\s+([A-Z][a-z]?)\\s+.*$",
					"captures": {
						"1": {
							"name": "constant.numeric.coordinate.x.sdf"
						},
						"2": {
							"name": "constant.numeric.coordinate.y.sdf"
						},
						"3": {
							"name": "constant.numeric.coordinate.z.sdf"
						},
						"4": {
							"name": "entity.name.type.element.sdf"
						}
					}
				}
			]
		},
		"bond_block": {
			"patterns": [
				{
					"name": "meta.bond.sdf",
					"match": "^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+).*$",
					"captures": {
						"1": {
							"name": "constant.numeric.atom1.sdf"
						},
						"2": {
							"name": "constant.numeric.atom2.sdf"
						},
						"3": {
							"name": "constant.numeric.bond-type.sdf"
						}
					}
				}
			]
		},
		"properties": {
			"patterns": [
				{
					"name": "keyword.control.property.sdf",
					"match": "^M\\s+END\\s*$"
				},
				{
					"name": "keyword.control.property.sdf",
					"match": "^M\\s+CHG.*$"
				},
				{
					"name": "keyword.control.property.sdf",
					"match": "^M\\s+RAD.*$"
				}
			]
		},
		"data_items": {
			"patterns": [
				{
					"name": "variable.other.data-header.sdf",
					"match": "^>\\s*<.*>\\s*$"
				}
			]
		},
		"record_separator": {
			"patterns": [
				{
					"name": "keyword.control.separator.sdf",
					"match": "^\\$\\$\\$\\$\\s*$"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.sdf",
					"match": "[-+]?\\d*\\.?\\d+([eE][-+]?\\d+)?"
				}
			]
		}
	},
	"scopeName": "source.sdf"
}